#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

smoke_root="$(mktemp -d)"
smoke_name=packaging
smoke_started=$SECONDS
echo "START distribution: $smoke_name"
smoke_stage() {
  echo "PASSED distribution: $smoke_name ($((SECONDS - smoke_started))s)"
  smoke_name="$1"
  smoke_started=$SECONDS
  echo "START distribution: $smoke_name"
}
smoke_finish() {
  smoke_status=$?
  if [[ "$smoke_status" == 0 ]]; then
    echo "PASSED distribution: $smoke_name ($((SECONDS - smoke_started))s)"
  else
    echo "FAILED distribution: $smoke_name ($((SECONDS - smoke_started))s; exit $smoke_status)" >&2
  fi
  rm -rf "$smoke_root"
  exit "$smoke_status"
}
trap smoke_finish EXIT

if [[ $# -gt 1 ]]; then
  echo "usage: scripts/wheel-smoke [distribution-directory]" >&2
  exit 1
fi

if [[ $# -eq 1 ]]; then
  dist_dir="$1"
  if [[ ! -d "$dist_dir" ]]; then
    echo "distribution directory does not exist: $dist_dir" >&2
    exit 1
  fi
else
  dist_dir="$smoke_root/dist"
  uv build --no-sources --out-dir "$dist_dir"
fi

shopt -s nullglob
wheels=("$dist_dir"/*.whl)
sdists=("$dist_dir"/*.tar.gz)
if [[ ${#wheels[@]} -ne 1 ]]; then
  echo "expected exactly one wheel in $dist_dir" >&2
  exit 1
fi
if [[ ${#sdists[@]} -ne 1 ]]; then
  echo "expected exactly one source distribution in $dist_dir" >&2
  exit 1
fi
wheel_path="${wheels[0]}"
sdist_path="${sdists[0]}"
uv run --locked python scripts/check_public_safety.py --distribution "$wheel_path" \
  --distribution "$sdist_path"
sdist_extract_root="$smoke_root/sdist"
mkdir -p "$sdist_extract_root"
tar -xzf "$sdist_path" -C "$sdist_extract_root"
sdist_roots=("$sdist_extract_root"/*)
if [[ ${#sdist_roots[@]} -ne 1 || ! -d "${sdist_roots[0]}" ]]; then
  echo "expected source distribution to contain one root directory" >&2
  exit 1
fi
sdist_root="${sdist_roots[0]}"

uv run --locked twine check "$wheel_path" "$sdist_path"
uv run --locked python scripts/distribution/inventory.py \
  --source "$repo_root" --wheel "$wheel_path" --sdist "$sdist_path"

smoke_stage runtime-installation
# Byte parity includes the declared runtime producer, so hold that context equal.
# A fresh wheel environment must not silently choose a newer Python patch release.
source_python="$(uv run --locked python -c 'import sys; print(sys.executable)')"
uv export --locked --no-dev --no-emit-project --format requirements-txt \
  --output-file "$smoke_root/runtime-constraints.txt" >/dev/null
uv venv --python "$source_python" "$smoke_root/venv"
uv pip install --python "$smoke_root/venv/bin/python" \
  --constraint "$smoke_root/runtime-constraints.txt" "$wheel_path"
uv pip check --python "$smoke_root/venv/bin/python"
smoke_stage installed-documentation
"$smoke_root/venv/bin/python" scripts/docs-smoke --content-root "$sdist_root"

smoke_stage facades-and-symbolic-compilation
source_digest="$(uv run --locked python -c 'import hop_design as hop; print(hop.compile(sequence="NRY", design_id="wheel-parity").bundle.manifest_digest)')"
wheel_digest="$("$smoke_root/venv/bin/python" -c 'import hop_design as hop; print(hop.compile(sequence="NRY", design_id="wheel-parity").bundle.manifest_digest)')"
if [[ "$source_digest" != "$wheel_digest" ]]; then
  echo "source/wheel bundle digest mismatch" >&2
  echo "source: $source_digest" >&2
  echo "wheel:  $wheel_digest" >&2
  exit 1
fi

source_facades="$(uv run --locked python - <<'PY'
import json
import hop_design as hop
import hop_design.construction as construction
import hop_design.discovery as discovery
import hop_design.methods as methods
import hop_design.spaces as spaces
import hop_design.views as views

print(json.dumps({
    "root": hop.__all__,
    "construction": construction.__all__,
    "discovery": discovery.__all__,
    "methods": methods.__all__,
    "spaces": spaces.__all__,
    "views": views.__all__,
}, sort_keys=True))
PY
)"
wheel_facades="$("$smoke_root/venv/bin/python" - <<'PY'
import json
import hop_design as hop
import hop_design.construction as construction
import hop_design.discovery as discovery
import hop_design.methods as methods
import hop_design.spaces as spaces
import hop_design.views as views

print(json.dumps({
    "root": hop.__all__,
    "construction": construction.__all__,
    "discovery": discovery.__all__,
    "methods": methods.__all__,
    "spaces": spaces.__all__,
    "views": views.__all__,
}, sort_keys=True))
PY
)"
if [[ "$source_facades" != "$wheel_facades" ]]; then
  echo "source/wheel public facade mismatch" >&2
  exit 1
fi

smoke_stage local-neighborhoods
local_foldback_request='examples/foldback-local-partition.yaml'
run_local_neighborhood_smoke() {
  local output="$1"
  shift
  "$@" - "$local_foldback_request" "$output" <<'PY'
import json
import sys
from pathlib import Path

import hop_design.construction as construction

request = Path(sys.argv[1])
output = Path(sys.argv[2])
receipt = construction.discover_local_neighborhood(request)
payload = json.loads(receipt.json_bytes)
strands = {
    realization["foldback_nick"]["strand"] for realization in payload["realizations"]
}
if (
    receipt.family != "foldback"
    or receipt.completion != "complete"
    or receipt.feasibility != "feasible"
):
    raise SystemExit("local foldback partition did not complete")
if strands != {"top", "bottom"}:
    raise SystemExit(f"local foldback partition omitted physical strands: {sorted(strands)}")
result = receipt.write(output) / "result.json"
loaded = construction.load_verified_local_neighborhood(result)
if loaded.result_id != receipt.result_id or loaded.json_bytes != receipt.json_bytes:
    raise SystemExit("local foldback partition failed reload verification")
batch_path = output.parent / (output.name + "-batch")
partial = construction.discover_local_neighborhoods(
    [request, request], batch_path, max_new_requests=1, batch_size=1,
)
if partial.finished or partial.completed_requests != 1:
    raise SystemExit("local collection lost its partial execution status")
resumed = construction.discover_local_neighborhoods(
    [request, request], batch_path, resume=True, batch_size=2,
)
if not resumed.finished or resumed.completed_requests != 2:
    raise SystemExit("local collection did not resume")
if any(item.json_bytes != receipt.json_bytes for item in resumed.iter_results()):
    raise SystemExit("local collection changed canonical result bytes")
space = construction.discover_foldback_sequence_space("examples/foldback-sequence-space.yaml")
space_path = space.write(output / "sequence-space") / "result.json"
loaded_space = construction.load_verified_foldback_sequence_space(space_path)
if loaded_space.json_bytes != space.json_bytes:
    raise SystemExit("foldback sequence space failed reload verification")
if (space.candidate_count, space.admitted_count) != (163840, 190):
    raise SystemExit("foldback sequence space changed its exact populations")
case = next(item for item in json.loads(space.json_bytes)["cases"] if item["sequences"]["cardinality"])
(output / "sequence-member.json").write_text(space.member_json(
    case_id=case["case_id"], rank=0, program_index=0,
))
basal_space = construction.discover_basal_sequence_space("examples/basal-sequence-space.yaml")
basal_path = basal_space.write(output / "basal-sequence-space") / "result.json"
loaded_basal = construction.load_verified_basal_sequence_space(basal_path)
if loaded_basal.json_bytes != basal_space.json_bytes:
    raise SystemExit("basal sequence space failed reload verification")
if (basal_space.candidate_count, basal_space.admitted_count) != (512, 4):
    raise SystemExit("basal sequence space changed its exact populations")
basal_case = next(item for item in json.loads(basal_space.json_bytes)["cases"] if item["sequences"]["cardinality"])
basal_program = next(i for i, item in enumerate(basal_case["programs"]) if item["sequences"]["cardinality"])
(output / "basal-sequence-member.json").write_text(basal_space.member_json(
    case_id=basal_case["case_id"], rank=0, program_index=basal_program,
))
print(result)
PY
}

source_local_result="$(
  run_local_neighborhood_smoke "$smoke_root/source-local-foldback" uv run --locked python
)"
wheel_local_result="$(
  run_local_neighborhood_smoke \
    "$smoke_root/wheel-local-foldback" \
    "$smoke_root/venv/bin/python"
)"
if ! cmp -s "$source_local_result" "$wheel_local_result"; then
  echo "source/wheel local-neighborhood canonical result mismatch" >&2
  exit 1
fi
for relative in sequence-space/result.json sequence-member.json basal-sequence-space/result.json basal-sequence-member.json; do
  if ! cmp -s "$(dirname "$source_local_result")/$relative" "$(dirname "$wheel_local_result")/$relative"; then
    echo "source/wheel sequence-space mismatch: $relative" >&2
    exit 1
  fi
done

smoke_stage basal-junction
uv run --locked python examples/basal-junction/search.py --out "$smoke_root/source-basal"
"$smoke_root/venv/bin/python" examples/basal-junction/search.py --out "$smoke_root/wheel-basal"
for relative in result/result.json matrix/projection.json matrix/projection.csv matrix/projection.svg; do
  if ! cmp -s "$smoke_root/source-basal/$relative" "$smoke_root/wheel-basal/$relative"; then
    echo "source/wheel basal-junction mismatch: $relative" >&2
    exit 1
  fi
done

smoke_stage scaffold-families
uv run --locked python examples/complete-construction/family.py --out "$smoke_root/source-family"
"$smoke_root/venv/bin/python" "$sdist_root/examples/complete-construction/family.py" --out "$smoke_root/wheel-family"
if ! diff -qr "$smoke_root/source-family" "$smoke_root/wheel-family"; then
  echo "source/wheel scaffold-family mismatch" >&2
  exit 1
fi

uv run --locked python examples/complete-construction/family.py --endpoint hairpin --out "$smoke_root/source-hairpin-family"
"$smoke_root/venv/bin/python" "$sdist_root/examples/complete-construction/family.py" --endpoint hairpin --out "$smoke_root/wheel-hairpin-family"
if ! diff -qr "$smoke_root/source-hairpin-family" "$smoke_root/wheel-hairpin-family"; then
  echo "source/wheel direct-hairpin family mismatch" >&2
  exit 1
fi
uv run --locked python examples/complete-construction/continue_family.py --out "$smoke_root/source-family-recovery"
"$smoke_root/venv/bin/python" "$sdist_root/examples/complete-construction/continue_family.py" --out "$smoke_root/wheel-family-recovery"
if ! diff -qr "$smoke_root/source-family-recovery" "$smoke_root/wheel-family-recovery"; then
  echo "source/wheel family recovery mismatch" >&2
  exit 1
fi

options_args=(--endpoint insert --max-continuations 12
  --option option-0005-01 --option option-0006-01
  --option option-0007-01 --option option-0008-01 --baseline option-0005-01)
smoke_stage product-options-and-terminals
uv run --locked python examples/scaffold-options/run.py \
  "${options_args[@]}" --out "$smoke_root/source-options"
"$smoke_root/venv/bin/python" "$sdist_root/examples/scaffold-options/run.py" \
  "${options_args[@]}" --out "$smoke_root/wheel-options"
if ! diff -qr "$smoke_root/source-options" "$smoke_root/wheel-options"; then
  echo "source/wheel scaffold-options mismatch" >&2
  exit 1
fi

uv run --locked python examples/scaffold-discovery/run.py "$smoke_root/source-scaffolds"
"$smoke_root/venv/bin/python" "$sdist_root/examples/scaffold-discovery/run.py" "$smoke_root/wheel-scaffolds"
if ! diff -qr "$smoke_root/source-scaffolds" "$smoke_root/wheel-scaffolds"; then
  echo "source/wheel product-first discovery mismatch" >&2
  exit 1
fi

uv run --locked python examples/scaffold-discovery/terminal_forms.py "$smoke_root/source-terminals"
"$smoke_root/venv/bin/python" "$sdist_root/examples/scaffold-discovery/terminal_forms.py" "$smoke_root/wheel-terminals"
if ! diff -qr "$smoke_root/source-terminals" "$smoke_root/wheel-terminals"; then
  echo "source/wheel terminal scaffold mismatch" >&2
  exit 1
fi

smoke_stage comparisons
for comparison_case in crossed methods hairpin grouped loop-sequences; do
  case "$comparison_case" in
    crossed) comparison_baseline=loop3-open17 ;;
    methods) comparison_baseline=bsai ;;
    hairpin) comparison_baseline=loop3 ;;
    grouped) comparison_baseline=loop3-bsai ;;
    loop-sequences) comparison_baseline=aaa-bsai ;;
  esac
  uv run --locked python examples/scaffold-comparison/run.py \
    --case "$comparison_case" --set set-0001 --baseline "$comparison_baseline" \
    --out "$smoke_root/source-comparison-$comparison_case"
  "$smoke_root/venv/bin/python" "$sdist_root/examples/scaffold-comparison/run.py" \
    --case "$comparison_case" --set set-0001 --baseline "$comparison_baseline" \
    --out "$smoke_root/wheel-comparison-$comparison_case"
  if ! diff -qr "$smoke_root/source-comparison-$comparison_case" "$smoke_root/wheel-comparison-$comparison_case"; then
    echo "source/wheel molecular comparison mismatch: $comparison_case" >&2
    exit 1
  fi
done

uv run --locked python examples/scaffold-comparison/controlled_panel.py --out "$smoke_root/source-controlled-panel"
"$smoke_root/venv/bin/python" "$sdist_root/examples/scaffold-comparison/controlled_panel.py" --out "$smoke_root/wheel-controlled-panel"
if ! diff -qr "$smoke_root/source-controlled-panel" "$smoke_root/wheel-controlled-panel"; then
  echo "source/wheel stage-controlled panel mismatch" >&2
  exit 1
fi

composed_construction=''
smoke_stage complete-preparation-and-compilation
uv run --locked python examples/complete-construction/run.py --out "$smoke_root/source-journey"
"$smoke_root/venv/bin/python" "$sdist_root/examples/complete-construction/run.py" --out "$smoke_root/wheel-journey"
for journey_case in released hairpin fixed-source-edit redesigned-source-edit; do
  if ! diff -qr "$smoke_root/source-journey/$journey_case" "$smoke_root/wheel-journey/$journey_case"; then
    echo "source/wheel complete journey mismatch: $journey_case" >&2
    exit 1
  fi
done

for construction_case in composed-pcr exact infeasible expanded-domain; do
  construction_trajectory_id=''
  if [[ "$construction_case" == "composed-pcr" ]]; then
    construction_trajectory_id='hop:materialized-construction/427a738083142d5f09f9b48bfade8b2e613bff8da96e068770f17ab1c0fd9f44@1'
  elif [[ "$construction_case" == "exact" ]]; then
    construction_trajectory_id='hop:materialized-construction/6ecfaedc4eb01e0fc24f52cfad089386bb94b39377ad9aabeb355c93fe8f7900@1'
  elif [[ "$construction_case" == "expanded-domain" ]]; then
    construction_trajectory_id='hop:materialized-construction/6ecfaedc4eb01e0fc24f52cfad089386bb94b39377ad9aabeb355c93fe8f7900@1'
  fi
  if [[ -n "$construction_trajectory_id" ]]; then
    source_construction="$(uv run --locked python examples/compile_construction.py \
      --design examples/construction-exact-design.yaml \
      --source "examples/construction-${construction_case}.yaml" \
      --out "$smoke_root/source-construction-${construction_case}" \
      --trajectory-realization-id "$construction_trajectory_id")"
    wheel_construction="$("$smoke_root/venv/bin/python" examples/compile_construction.py \
      --design examples/construction-exact-design.yaml \
      --source "examples/construction-${construction_case}.yaml" \
      --out "$smoke_root/wheel-construction-${construction_case}" \
      --trajectory-realization-id "$construction_trajectory_id")"
  else
    source_construction="$(uv run --locked python examples/compile_construction.py \
      --design examples/construction-exact-design.yaml \
      --source "examples/construction-${construction_case}.yaml" \
      --out "$smoke_root/source-construction-${construction_case}")"
    wheel_construction="$("$smoke_root/venv/bin/python" examples/compile_construction.py \
      --design examples/construction-exact-design.yaml \
      --source "examples/construction-${construction_case}.yaml" \
      --out "$smoke_root/wheel-construction-${construction_case}")"
  fi
  if [[ "$source_construction" != "$wheel_construction" ]]; then
    echo "source/wheel construction mismatch: $construction_case" >&2
    exit 1
  fi
  if [[ "$construction_case" == "composed-pcr" ]]; then
    composed_construction="$source_construction"
  fi
done

smoke_stage navigation-and-methods
wheel_navigation_bundle="$smoke_root/wheel-construction-composed-pcr/construction"
wheel_navigation_id="$(
  printf '%s' "$composed_construction" \
    | uv run --locked python -c \
      'import json, sys; print(json.load(sys.stdin)["selected_trajectory_realization_id"])'
)"
"$smoke_root/venv/bin/hop-design" construction summary "$wheel_navigation_bundle" >/dev/null
"$smoke_root/venv/bin/hop-design" construction list "$wheel_navigation_bundle" --limit 1 >/dev/null
"$smoke_root/venv/bin/hop-design" construction select "$wheel_navigation_bundle" \
  "$wheel_navigation_id" --out "$smoke_root/wheel-selected-route.json" >/dev/null
"$smoke_root/venv/bin/hop-design" construction inspect "$wheel_navigation_bundle" \
  --selection "$smoke_root/wheel-selected-route.json" \
  --out "$smoke_root/wheel-selected-trajectory" >/dev/null

source_comparison="$(uv run --locked hop-design construction compare \
  "$smoke_root/source-construction-composed-pcr/construction" \
  "$smoke_root/source-construction-exact/construction" \
  --left-ordinal 0 --right-ordinal 0)"
wheel_comparison="$("$smoke_root/venv/bin/hop-design" construction compare \
  "$wheel_navigation_bundle" "$smoke_root/wheel-construction-exact/construction" \
  --left-ordinal 0 --right-ordinal 0)"
if [[ "$source_comparison" != "$wheel_comparison" ]]; then
  echo "source/wheel construction comparison mismatch" >&2
  exit 1
fi

source_discovery="$(uv run --locked python examples/discover_basal_candidates.py)"
wheel_discovery="$("$smoke_root/venv/bin/python" examples/discover_basal_candidates.py)"
if [[ "$source_discovery" != "$wheel_discovery" ]]; then
  echo "source/wheel discovery mismatch" >&2
  exit 1
fi

method_request="examples/linear-source-method.json"
source_method_digest="$(uv run --locked python scripts/method-bundle-smoke.py "$method_request")"
wheel_method_digest="$(
  "$smoke_root/venv/bin/python" scripts/method-bundle-smoke.py "$method_request"
)"
if [[ "$source_method_digest" != "$wheel_method_digest" ]]; then
  echo "source/wheel method-bundle digest mismatch" >&2
  echo "source: $source_method_digest" >&2
  echo "wheel:  $wheel_method_digest" >&2
  exit 1
fi

"$smoke_root/venv/bin/hop-design" compile \
  --sequence NRY \
  --design-id wheel-cli \
  --out "$smoke_root/bundle" >/dev/null
"$smoke_root/venv/bin/python" -c \
  'import hop_design as hop; import sys; hop.verify_bundle(sys.argv[1])' \
  "$smoke_root/bundle"
"$smoke_root/venv/bin/python" scripts/method-bundle-smoke.py \
  "$method_request" \
  --out "$smoke_root/method-bundle" >/dev/null
installed_version="$("$smoke_root/venv/bin/python" -c \
  'from importlib.metadata import version; print(version("hop-design"))')"
test "$("$smoke_root/venv/bin/hop-design" --version)" = "hop-design $installed_version"

smoke_stage editing-and-browser-assets
source_edit="$(uv run --locked python examples/molecular-editing/run.py "$smoke_root/source-molecular-edit")"
wheel_edit="$("$smoke_root/venv/bin/python" examples/molecular-editing/run.py "$smoke_root/wheel-molecular-edit")"
if [[ "$source_edit" != "$wheel_edit" ]]; then
  echo "source/wheel molecular edit and retrieval mismatch" >&2
  exit 1
fi
"$smoke_root/venv/bin/python" -c 'from importlib.resources import files; assets = files("hop_design").joinpath("assets/molecular_editor"); assert all(assets.joinpath(n).is_file() for n in ("index.html", "editor.js", "editor.css"))'
"$smoke_root/venv/bin/python" -c 'from importlib.resources import files; assets = files("hop_design").joinpath("assets/variant_explorer"); assert all(assets.joinpath(n).is_file() for n in ("index.html", "editor.js", "editor.css", "choice_space_model.js", "choice_space_brush.js", "choice_space_axes.js", "choice_space_coverage.js", "choice_space_local.js", "parameter_key.js", "envelope_browser.js", "envelope_model.js", "envelope_fields.js"))'

"$smoke_root/venv/bin/python" -c 'from importlib.resources import files; assets = files("hop_design").joinpath("assets/survey_explorer"); assert all(assets.joinpath(n).is_file() for n in ("index.html", "editor.js", "editor.css", "model.js", "plot.js", "atlas.js"))'
"$smoke_root/venv/bin/hop-design" construction survey view --help >/dev/null

smoke_stage parameter-and-envelope-revisions
source_parameters="$(uv run --locked python examples/molecular-editing/parameters.py "$smoke_root/source-molecular-edit/alternatives" "$smoke_root/source-parameters")"
wheel_parameters="$("$smoke_root/venv/bin/python" examples/molecular-editing/parameters.py "$smoke_root/wheel-molecular-edit/alternatives" "$smoke_root/wheel-parameters")"
if [[ "$source_parameters" != "$wheel_parameters" ]]; then
  echo "source/wheel parameter query, evaluation and retrieval mismatch" >&2
  exit 1
fi

source_envelope="$(uv run --locked python examples/molecular-editing/envelope.py "$smoke_root/source-molecular-edit/alternatives" "$smoke_root/source-envelope")"
wheel_envelope="$("$smoke_root/venv/bin/python" examples/molecular-editing/envelope.py "$smoke_root/wheel-molecular-edit/alternatives" "$smoke_root/wheel-envelope")"
if [[ "$source_envelope" != "$wheel_envelope" ]]; then
  echo "source/wheel envelope revision mismatch" >&2
  exit 1
fi

smoke_stage interface-survey
source_survey="$(uv run --locked python scripts/interface-survey-smoke.py)"
wheel_survey="$("$smoke_root/venv/bin/python" scripts/interface-survey-smoke.py --content-root "$sdist_root")"
if [[ "$source_survey" != "$wheel_survey" ]]; then
  echo "source/wheel interface-survey resume, replay and retrieval mismatch" >&2
  exit 1
fi

smoke_stage optional-intent-and-edition
source_design="$(uv run --locked python scripts/design-discovery-smoke.py)"
wheel_design="$("$smoke_root/venv/bin/python" scripts/design-discovery-smoke.py)"
if [[ "$source_design" != "$wheel_design" ]]; then
  echo "source/wheel optional design intent, selection, atlas and handoff mismatch" >&2
  exit 1
fi

echo "Distribution smoke and source parity: ok ($source_digest; $source_method_digest)"
