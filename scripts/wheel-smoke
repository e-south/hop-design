#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

smoke_root="$(mktemp -d)"
trap 'rm -rf "$smoke_root"' EXIT

if [[ $# -gt 1 ]]; then
  echo "usage: scripts/wheel-smoke [distribution-directory]" >&2
  exit 1
fi

if [[ $# -eq 1 ]]; then
  dist_dir="$1"
  if [[ ! -d "$dist_dir" ]]; then
    echo "distribution directory does not exist: $dist_dir" >&2
    exit 1
  fi
else
  dist_dir="$smoke_root/dist"
  uv build --no-sources --out-dir "$dist_dir"
fi

shopt -s nullglob
wheels=("$dist_dir"/*.whl)
sdists=("$dist_dir"/*.tar.gz)
if [[ ${#wheels[@]} -ne 1 ]]; then
  echo "expected exactly one wheel in $dist_dir" >&2
  exit 1
fi
if [[ ${#sdists[@]} -ne 1 ]]; then
  echo "expected exactly one source distribution in $dist_dir" >&2
  exit 1
fi
wheel_path="${wheels[0]}"
sdist_path="${sdists[0]}"
sdist_extract_root="$smoke_root/sdist"
mkdir -p "$sdist_extract_root"
tar -xzf "$sdist_path" -C "$sdist_extract_root"
sdist_roots=("$sdist_extract_root"/*)
if [[ ${#sdist_roots[@]} -ne 1 || ! -d "${sdist_roots[0]}" ]]; then
  echo "expected source distribution to contain one root directory" >&2
  exit 1
fi
sdist_root="${sdist_roots[0]}"

uv run --locked twine check "$wheel_path" "$sdist_path"
sdist_contents="$(tar -tzf "$sdist_path")"
for forbidden in '/.agents/' '/.github/' '/scripts/' '/tests/'; do
  if grep -Fq "$forbidden" <<<"$sdist_contents"; then
    echo "sdist contains repository-only path: $forbidden" >&2
    exit 1
  fi
done
for required in \
  'LICENSE' \
  'README.md' \
  'CONTRIBUTING.md' \
  'SECURITY.md' \
  'ARCHITECTURE.md' \
  'DESIGN.md' \
  'RELIABILITY.md' \
  'assets/hop-design-banner.svg' \
  'assets/examples/basal-junction.svg' \
  'assets/examples/foldback-junction.svg' \
  'docs/index.md' \
  'examples/author_linear_source_method.py' \
  'examples/compile_payload_records.py' \
  'examples/compile_construction.py' \
  'examples/construction-composed-pcr.yaml' \
  'examples/compile_linear_source_method.py' \
  'examples/construction-exact-design.yaml' \
  'examples/construction-exact.yaml' \
  'examples/construction-infeasible.yaml' \
  'examples/construction-expanded-domain.yaml' \
  'examples/discover_basal_candidates.py' \
  'examples/fixed-site-three-base-context.yaml' \
  'examples/foldback-local-partition.yaml' \
  'examples/generic-symbolic.yaml' \
  'examples/linear-source-matched-design.yaml' \
  'examples/linear-source-method.json' \
  'examples/render_component_views.py' \
  'examples/verify_design_method_handoff.py'; do
  if ! grep -Fq "/$required" <<<"$sdist_contents"; then
    echo "sdist omits README-routed content: $required" >&2
    exit 1
  fi
done

uv venv --python 3.12 "$smoke_root/venv"
uv pip install --python "$smoke_root/venv/bin/python" "$wheel_path"
uv pip check --python "$smoke_root/venv/bin/python"
"$smoke_root/venv/bin/python" scripts/docs-smoke --content-root "$sdist_root"

source_digest="$(uv run --locked python -c 'import hop_design as hop; print(hop.compile(sequence="NRY", design_id="wheel-parity").bundle.manifest_digest)')"
wheel_digest="$("$smoke_root/venv/bin/python" -c 'import hop_design as hop; print(hop.compile(sequence="NRY", design_id="wheel-parity").bundle.manifest_digest)')"
if [[ "$source_digest" != "$wheel_digest" ]]; then
  echo "source/wheel bundle digest mismatch" >&2
  echo "source: $source_digest" >&2
  echo "wheel:  $wheel_digest" >&2
  exit 1
fi

source_facades="$(uv run --locked python - <<'PY'
import json
import hop_design as hop
import hop_design.construction as construction
import hop_design.discovery as discovery
import hop_design.methods as methods
import hop_design.spaces as spaces
import hop_design.views as views

print(json.dumps({
    "root": hop.__all__,
    "construction": construction.__all__,
    "discovery": discovery.__all__,
    "methods": methods.__all__,
    "spaces": spaces.__all__,
    "views": views.__all__,
}, sort_keys=True))
PY
)"
wheel_facades="$("$smoke_root/venv/bin/python" - <<'PY'
import json
import hop_design as hop
import hop_design.construction as construction
import hop_design.discovery as discovery
import hop_design.methods as methods
import hop_design.spaces as spaces
import hop_design.views as views

print(json.dumps({
    "root": hop.__all__,
    "construction": construction.__all__,
    "discovery": discovery.__all__,
    "methods": methods.__all__,
    "spaces": spaces.__all__,
    "views": views.__all__,
}, sort_keys=True))
PY
)"
if [[ "$source_facades" != "$wheel_facades" ]]; then
  echo "source/wheel public facade mismatch" >&2
  exit 1
fi

local_foldback_request='examples/foldback-local-partition.yaml'
run_local_neighborhood_smoke() {
  local output="$1"
  shift
  "$@" - "$local_foldback_request" "$output" <<'PY'
import json
import sys
from pathlib import Path

import hop_design.construction as construction

request = Path(sys.argv[1])
output = Path(sys.argv[2])
receipt = construction.discover_local_neighborhood(request)
payload = json.loads(receipt.json_bytes)
strands = {
    realization["foldback_nick"]["strand"] for realization in payload["realizations"]
}
if receipt.family != "foldback" or receipt.status != "complete":
    raise SystemExit("local foldback partition did not complete")
if strands != {"top", "bottom"}:
    raise SystemExit(f"local foldback partition omitted physical strands: {sorted(strands)}")
result = receipt.write(output) / "result.json"
loaded = construction.load_verified_local_neighborhood(result)
if loaded.result_id != receipt.result_id or loaded.json_bytes != receipt.json_bytes:
    raise SystemExit("local foldback partition failed reload verification")
print(result)
PY
}

source_local_result="$(
  run_local_neighborhood_smoke "$smoke_root/source-local-foldback" uv run --locked python
)"
wheel_local_result="$(
  run_local_neighborhood_smoke \
    "$smoke_root/wheel-local-foldback" \
    "$smoke_root/venv/bin/python"
)"
if ! cmp -s "$source_local_result" "$wheel_local_result"; then
  echo "source/wheel local-neighborhood canonical result mismatch" >&2
  exit 1
fi

composed_construction=''
for construction_case in composed-pcr exact infeasible expanded-domain; do
  construction_trajectory_id=''
  if [[ "$construction_case" == "composed-pcr" ]]; then
    construction_trajectory_id='hop:materialized-construction/1ae3c749630ea0bcd412463d9f09ceb0ca187991aa42c667be35299621f3f325@1'
  elif [[ "$construction_case" == "exact" ]]; then
    construction_trajectory_id='hop:materialized-construction/18b865aacc420439aa8fefe839ee1f4d6743b5d5588142adee713cebcfe55877@1'
  elif [[ "$construction_case" == "expanded-domain" ]]; then
    construction_trajectory_id='hop:materialized-construction/18b865aacc420439aa8fefe839ee1f4d6743b5d5588142adee713cebcfe55877@1'
  fi
  if [[ -n "$construction_trajectory_id" ]]; then
    source_construction="$(uv run --locked python examples/compile_construction.py \
      --design examples/construction-exact-design.yaml \
      --source "examples/construction-${construction_case}.yaml" \
      --out "$smoke_root/source-construction-${construction_case}" \
      --trajectory-realization-id "$construction_trajectory_id")"
    wheel_construction="$("$smoke_root/venv/bin/python" examples/compile_construction.py \
      --design examples/construction-exact-design.yaml \
      --source "examples/construction-${construction_case}.yaml" \
      --out "$smoke_root/wheel-construction-${construction_case}" \
      --trajectory-realization-id "$construction_trajectory_id")"
  else
    source_construction="$(uv run --locked python examples/compile_construction.py \
      --design examples/construction-exact-design.yaml \
      --source "examples/construction-${construction_case}.yaml" \
      --out "$smoke_root/source-construction-${construction_case}")"
    wheel_construction="$("$smoke_root/venv/bin/python" examples/compile_construction.py \
      --design examples/construction-exact-design.yaml \
      --source "examples/construction-${construction_case}.yaml" \
      --out "$smoke_root/wheel-construction-${construction_case}")"
  fi
  if [[ "$source_construction" != "$wheel_construction" ]]; then
    echo "source/wheel construction mismatch: $construction_case" >&2
    exit 1
  fi
  if [[ "$construction_case" == "composed-pcr" ]]; then
    composed_construction="$source_construction"
  fi
done

wheel_navigation_bundle="$smoke_root/wheel-construction-composed-pcr/construction"
wheel_navigation_id="$(
  printf '%s' "$composed_construction" \
    | uv run --locked python -c \
      'import json, sys; print(json.load(sys.stdin)["selected_trajectory_realization_id"])'
)"
"$smoke_root/venv/bin/hop-design" construction summary "$wheel_navigation_bundle" >/dev/null
"$smoke_root/venv/bin/hop-design" construction list "$wheel_navigation_bundle" --limit 1 >/dev/null
"$smoke_root/venv/bin/hop-design" construction select "$wheel_navigation_bundle" \
  "$wheel_navigation_id" --out "$smoke_root/wheel-selected-route.json" >/dev/null
"$smoke_root/venv/bin/hop-design" construction inspect "$wheel_navigation_bundle" \
  --selection "$smoke_root/wheel-selected-route.json" \
  --out "$smoke_root/wheel-selected-trajectory" >/dev/null

source_discovery="$(uv run --locked python examples/discover_basal_candidates.py)"
wheel_discovery="$("$smoke_root/venv/bin/python" examples/discover_basal_candidates.py)"
if [[ "$source_discovery" != "$wheel_discovery" ]]; then
  echo "source/wheel discovery mismatch" >&2
  exit 1
fi

method_request="examples/linear-source-method.json"
source_method_digest="$(uv run --locked python scripts/method-bundle-smoke.py "$method_request")"
wheel_method_digest="$(
  "$smoke_root/venv/bin/python" scripts/method-bundle-smoke.py "$method_request"
)"
if [[ "$source_method_digest" != "$wheel_method_digest" ]]; then
  echo "source/wheel method-bundle digest mismatch" >&2
  echo "source: $source_method_digest" >&2
  echo "wheel:  $wheel_method_digest" >&2
  exit 1
fi

"$smoke_root/venv/bin/hop-design" compile \
  --sequence NRY \
  --design-id wheel-cli \
  --out "$smoke_root/bundle" >/dev/null
"$smoke_root/venv/bin/python" -c \
  'import hop_design as hop; import sys; hop.verify_bundle(sys.argv[1])' \
  "$smoke_root/bundle"
"$smoke_root/venv/bin/python" scripts/method-bundle-smoke.py \
  "$method_request" \
  --out "$smoke_root/method-bundle" >/dev/null
installed_version="$("$smoke_root/venv/bin/python" -c \
  'from importlib.metadata import version; print(version("hop-design"))')"
test "$("$smoke_root/venv/bin/hop-design" --version)" = "hop-design $installed_version"

echo "Distribution smoke and source parity: ok ($source_digest; $source_method_digest)"
